        <!-- ═══════════════════════════════════ -->
        <!-- LAYER 1: USER / DEVICES            -->
        <!-- ═══════════════════════════════════ -->

        <mxCell id="user" value="User / Singer" style="shape=mxgraph.general.person2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="190" y="90" width="60" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mic" value="Microphone&#xa;(sounddevice)" style="shape=mxgraph.cisco.computers_and_peripherals.microphone;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="90" width="60" height="80" as="geometry" />
        </mxCell>

        <mxCell id="speaker" value="Speaker / Output&#xa;(pygame mixer)" style="shape=mxgraph.cisco.computers_and_peripherals.speaker;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="60" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- LAYER 2: STREAMLIT UI              -->
        <!-- ═══════════════════════════════════ -->

        <mxCell id="ui_bar" value="&lt;b&gt;app.py — Streamlit Application&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9a825;strokeColor=#e65100;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="258" width="1400" height="28" as="geometry" />
        </mxCell>

        <mxCell id="ui_selector" value="&lt;b&gt;Pitch / Scale Selector&lt;/b&gt;&#xa;&#xa;st.selectbox: Sa = C, C#, D…B&#xa;Indian names: Safed 1-7 / Kali 1-5&#xa;Updates session_state.selected_pitch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="150" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui_swaramap" value="&lt;b&gt;Swara Map Display&lt;/b&gt;&#xa;&#xa;Sa · Re · Ga · Ma · Pa · Dha · Ni&#xa;Each swara: note name + freq (Hz)&#xa;Komal / Tivra variants highlighted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="385" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui_keyboard" value="&lt;b&gt;Visual Harmonium Keyboard&lt;/b&gt;&#xa;&#xa;12-key SVG/HTML keyboard&#xa;Active swara key highlighted&#xa;Shows Sa root position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="620" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui_playback" value="&lt;b&gt;Playback Controls&lt;/b&gt;&#xa;&#xa;[Play] button per swara&#xa;[Aaroh] full scale ascending&#xa;[Avaroh] full scale descending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="855" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui_chat" value="&lt;b&gt;AI Chat Interface&lt;/b&gt;&#xa;&#xa;st.chat_input: user message&#xa;st.chat_message: AI response&#xa;Streams tokens as they arrive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1090" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ui_pitchfb" value="&lt;b&gt;Live Pitch Feedback&lt;/b&gt;&#xa;&#xa;Detected: &quot;Ga&quot; (E4, 330 Hz)&#xa;Status: Flat by 15 cents&#xa;Target swara highlighted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1325" y="296" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Session State -->
        <mxCell id="ui_session" value="&lt;b&gt;Streamlit Session State&lt;/b&gt;&#xa;selected_pitch: str&#xa;active_swaras: dict&#xa;chat_history: list[dict]&#xa;is_listening: bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="150" y="418" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- LAYER 3: CORE LOGIC MODULES        -->
        <!-- ═══════════════════════════════════ -->

        <mxCell id="mod_mapper" value="&lt;b&gt;swara_mapper.py&lt;/b&gt;&#xa;&#xa;get_swaras(sa_pitch: str) → dict&#xa;get_note_name(swara, pitch) → str&#xa;get_komal_tivra_variants() → list&#xa;indian_pitch_name(note: str) → str&#xa;freq_for_note(note: str) → float" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="150" y="515" width="250" height="145" as="geometry" />
        </mxCell>

        <mxCell id="mod_audio" value="&lt;b&gt;audio_player.py&lt;/b&gt;&#xa;&#xa;load_samples(path: str) → dict&#xa;play_note(note: str) → None&#xa;play_scale_aaroh(swaras: list) → None&#xa;play_scale_avaroh(swaras: list) → None&#xa;stop() → None&#xa;[uses pygame.mixer]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="515" width="250" height="145" as="geometry" />
        </mxCell>

        <mxCell id="mod_agent" value="&lt;b&gt;agent.py&lt;/b&gt;&#xa;&#xa;build_system_prompt(swaras) → str&#xa;chat(history: list, msg: str) → stream&#xa;stream_response(stream) → Generator&#xa;format_swara_context(swaras) → str&#xa;[uses anthropic.Anthropic()]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="750" y="515" width="270" height="145" as="geometry" />
        </mxCell>

        <mxCell id="mod_pitch" value="&lt;b&gt;pitch_detector.py&lt;/b&gt;&#xa;&#xa;start_stream() / stop_stream()&#xa;capture_buffer() → np.ndarray&#xa;detect_frequency(buf) → float (Hz)&#xa;map_to_swara(hz, swaras) → str&#xa;cents_deviation(detected, target) → int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1070" y="515" width="270" height="145" as="geometry" />
        </mxCell>

        <!-- Audio Pipeline Detail -->
        <mxCell id="pipeline" value="&lt;b&gt;Audio Processing Pipeline&lt;/b&gt;&#xa;(pitch_detector internals)&#xa;&#xa;sounddevice.InputStream&#xa;→ float32 numpy buffer&#xa;→ librosa.yin(sr=44100)&#xa;→ Hz → nearest semitone&#xa;→ swara name + cents offset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7b1fa2;fontSize=10;spacingLeft=8;spacingTop=6;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1390" y="510" width="150" height="150" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- LAYER 4: EXTERNAL / DATA           -->
        <!-- ═══════════════════════════════════ -->

        <mxCell id="ext_samples" value="&lt;b&gt;/samples/&lt;/b&gt;&#xa;C.wav · C#.wav · D.wav · D#.wav&#xa;E.wav · F.wav · F#.wav · G.wav&#xa;G#.wav · A.wav · A#.wav · B.wav&#xa;(12 harmonium WAV files)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;spacingLeft=8;spacingTop=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="762" width="270" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ext_api" value="&lt;b&gt;Anthropic Claude API&lt;/b&gt;&#xa;Model: claude-sonnet-4-6&#xa;Endpoint: messages.stream()&#xa;Transport: HTTPS / SSE&#xa;Returns: streamed text chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;spacingLeft=8;spacingTop=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="750" y="762" width="270" height="100" as="geometry" />

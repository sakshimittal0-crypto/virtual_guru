        <mxCell id="e_agent_env" value="load_dotenv() / ANTHROPIC_API_KEY" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;dashed=1;" edge="1" source="mod_agent" target="ext_env" parent="1">
